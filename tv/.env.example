# TD;DW TV settings. Copy to tv/.env and fill in. Never commit tv/.env.

# Jellyfin, as the container sees it: a LAN IP or hostname, not localhost.
JELLYFIN_URL=http://jellyfin.local:8096
# Dashboard > API Keys > + . Give TD;DW its own key (e.g. "td-dw-tv").
JELLYFIN_API_KEY=
# Optional: part of the TV's device or client name (e.g. SHIELD).
# Empty = whichever session played most recently.
JELLYFIN_DEVICE=

# Shared secret for the TV button and phone bookmark URLs.
# Generate one with: openssl rand -hex 24
TDDW_TV_KEY=

# Any OpenAI-compatible endpoint: OpenRouter, Gemini, LiteLLM, Ollama, llama.cpp...
LLM_BASE_URL=https://openrouter.ai/api/v1
# Leave blank for local endpoints that don't need one.
LLM_API_KEY=
LLM_MODEL=google/gemini-3.8-flash

# Optional tuning (defaults shown).
SUMMARY_LENGTH=medium
TRANSCRIPT_BUDGET=standard
SPOILER_FREE_ANSWERS=true
PAUSE_ON_RECAP=true
SUBTITLE_LANG=en
PORT=8795
