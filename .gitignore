# --- Secrets / credentials (defensive: nothing sensitive should ever land here) ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
*.crx
*.pem.pub

# --- web-ext / AMO signing (defensive; the real outputs are already under dist/) ---
# web-ext-config.* is the important one: that file is executable JS holding your
# AMO API secret, and a stray `channel: "listed"` in one would publish the add-on.
web-ext-artifacts/
web-ext-config.*
*.xpi

# --- Node (in case build tooling is added later) ---
node_modules/
dist/
build/
npm-debug.log*
yarn-error.log*

# --- Internal dev notes (kept local, not published) ---
HANDOFF.md
